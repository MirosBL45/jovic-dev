# MongoDB connection string
MONGO_URL=

# Production database for the db scripts only (backup, restore, migrations)
# Local only, never on Vercel. Locally MONGO_URL points to the dev database
MONGO_URL_PRODUCTION=

# NextAuth and Google OAuth
# NEXTAUTH_URL is http://localhost:3000 in local development
NEXTAUTH_URL=
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ownerId of the admin (the owner's Google account), for example google:123456789
# In development the dashboard shows your ownerId so you can copy it here
ADMIN_ID=

# EmailJS (public by design of the browser SDK)
NEXT_PUBLIC_SERVICE_KEY=
NEXT_PUBLIC_TEMPLATE_KEY=
NEXT_PUBLIC_MAIN_PUBLIC_KEY=

# Base URL used for requests to the site's own API
NEXT_PUBLIC_NAME_OF_LINK=
